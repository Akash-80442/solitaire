{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@app-types": ["src/types"],
      "@app-types/*": ["src/types/*"]
    }
  }
}
